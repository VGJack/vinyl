{
  "name": "vinyl-browser",
  "productName": "Vinyl",
  "version": "0.5.0",
  "description": "Vinyl desktop browser with a native bookmark drawer, retractable navigation, and a live minimal start page",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "node scripts/configure-build.js && electron-builder --config builder.generated.json --win nsis --x64",
    "build:linux": "node scripts/configure-build.js && electron-builder --config builder.generated.json --linux AppImage --x64",
    "check": "node --check main.js && node --check preload.js && node --check google-account.js && node --check updates.js && node --check store.js && node --check import-bookmarks.js && node --check home-data.js && node --check ui/app.js && node tests/store.test.js && node tests/chrome-bridge.test.js && node tests/google-account.test.js && node tests/updates.test.js && node tests/google-login-flow.test.js && node --check scripts/configure-build.js && node tests/import-bookmarks.test.js && node tests/home-data.test.js"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "app.vinyl.browser",
    "productName": "Vinyl",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "store.js",
      "home-data.js",
      "chrome-bridge.js",
      "import-bookmarks.js",
      "google-account.js",
      "updates.js",
      "update-config.json",
      "preload.js",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "update-config.json",
        "to": "update-config.json"
      }
    ],
    "win": {
      "icon": "assets/vinyl.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vinyl",
      "artifactName": "Vinyl-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/vinyl.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": null
  }
}
